generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id        String   @id
  name      String   @unique
  price     Float
  stock     Int
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([price])
  @@index([createdAt])
}
